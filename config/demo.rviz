Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.1
    Plane Cell Count: 40
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/RobotModel
    Name: Left arm
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /left/arm/robot_description
    TF Prefix: left/arm
  - Class: rviz_default_plugins/RobotModel
    Name: Right arm
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /right/arm/robot_description
    TF Prefix: right/arm
  - Class: rviz_default_plugins/RobotModel
    Name: Left hand
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /left/robot_description
    TF Prefix: left
  - Class: rviz_default_plugins/RobotModel
    Name: Right hand
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /right/robot_description
    TF Prefix: right
  - Class: rviz_default_plugins/Image
    Name: Camera
    Enabled: true
    Topic:
      Value: /demo/image
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.3
      Pitch: 0.45
      Yaw: 0.0
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1400
  Height: 800
