Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Left hand
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /left/robot_description
      TF Prefix: left
    - Class: rviz_default_plugins/RobotModel
      Name: Right hand
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /right/robot_description
      TF Prefix: right
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.7
      Focal Point:
        X: 0
        Y: 0
        Z: 0.1
      Pitch: 0.2
      Yaw: 0
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1400
  Height: 800
